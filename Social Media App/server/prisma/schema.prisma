generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  fullName    String?   @default("")
  username    String    @unique
  email       String    @unique
  password    String
  profilePic  String?   @default("")
  about       String?   @default("Hey there! I am using SocialX.")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts       Post[]
  likes       Like[]
  comments    Comment[]
  stories     Story[]

  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")

  followedBy  Follow[]  @relation("following")
  following   Follow[]  @relation("follower")

  sentRequests     MessageRequest[] @relation("sentRequests")
  receivedRequests MessageRequest[] @relation("receivedRequests")

  messageReactions MessageReaction[] @relation("userReactions")

  lastActiveAt DateTime?

  @@index([email])
  @@index([username])
}

model Post {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  userPic     String?
  fileType    String   @default("photo")
  file        String
  description String?  @db.Text
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       Like[]
  comments    Comment[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Story {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  userPic   String?  @default("")
  file      String
  fileType  String   @default("photo")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  // Reply to another message
  replyToId String?

  // Used for the first message of a private message request
  requestId String?

  sender   User @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  replyTo Message?  @relation("messageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[]  @relation("messageReplies")

  request MessageRequest? @relation("requestMessages", fields: [requestId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([replyToId])
  @@index([requestId])
}


enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MessageRequest {
  id          String               @id @default(uuid())
  requesterId String
  recipientId String
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  requester User @relation("sentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("receivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  messages Message[] @relation("requestMessages")

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}


model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("userReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}