generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  email       String    @unique
  password    String
  profilePic  String?   @default("")
  about       String?   @default("Hey there! I am using SocialX.")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  posts       Post[]
  likes       Like[]
  comments    Comment[]

  // Self-referential Many-to-Many for Followers / Following
  followedBy  Follow[]  @relation("following")
  following   Follow[]  @relation("follower")
}

model Post {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  userPic     String?
  fileType    String    @default("photo") // "photo" or "video"
  file        String
  description String?   @db.Text
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  likes       Like[]
  comments    Comment[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Composite unique constraint: A user can like a post only once
  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  // Composite primary key: Prevents duplicate follow records
  @@id([followerId, followingId])
}